{
  "hosts": {
    "dns.google": ["8.8.8.8", "8.8.4.4"],
    "common.dns.yandex.net": ["77.88.8.8", "77.88.8.1"]
  },
  "servers": [
    {
      "address": "https://dns.google/dns-query",
